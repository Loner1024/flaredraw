{
  "name": "flaredraw",
  "account_id": "5dcdb6c96e93d90e6b34559e4d307671",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/oauth/*"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaredraw-db",
      "database_id": "5b676ff8-6935-4f6f-9d4d-2e8e6d98349c",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "flaredraw-storage",
      "preview_bucket_name": "flaredraw-storage",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "routes": [{ "pattern": "draw.uniix.dev", "custom_domain": true }],
}
